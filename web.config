<?xml version="1.0" encoding="UTF-8"?>

<configuration>
  <system.webServer>

    <rewrite>
      <rules>

        <!-- Redirect WWW to Non-WWW -->
        

        <!-- NextJS Reverse Proxy -->
        <rule name="NextJS Reverse Proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
                <rule name="Redirect WWW to Non-WWW" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTP_HOST}" pattern="^www\.izhtech\.com$" />
                    </conditions>
                    <action type="Redirect" url="https://izhtech.com/{R:1}" />
                </rule>

      </rules>
    </rewrite>
        <httpProtocol>
            <customHeaders>
                <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
            </customHeaders>
        </httpProtocol>

  </system.webServer>
</configuration>